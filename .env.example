# Configurações do Google Tag Manager
# Descomente e configure os IDs específicos para cada ambiente

# Produção
# NEXT_PUBLIC_GTM_ID=GTM-K3SBSHG5

# Desenvolvimento (opcional - pode usar o mesmo ID da produção)
# NEXT_PUBLIC_GTM_ID_DEV=GTM-K3SBSHG5

# Teste (opcional - pode usar o mesmo ID da produção)
# NEXT_PUBLIC_GTM_ID_TEST=GTM-K3SBSHG5

# Para desabilitar GTM completamente em desenvolvimento
# NEXT_PUBLIC_DISABLE_GTM=true

# Outras configurações
NEXT_PUBLIC_APP_URL=https://opens.com.br
